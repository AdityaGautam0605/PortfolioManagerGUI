{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://folio-api-zcma.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "framework": "vite"
}
